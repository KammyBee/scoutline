# Copy to .env.local for local work. On Vercel, add these in Project Settings → Environment Variables.

# Postgres connection string (Neon: use the "pooled" connection string). Leave unset locally to use a built-in PGlite database in .data/
DATABASE_URL=

# The password you type on the sign-in page.
APP_PASSWORD=

# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your time zone, used for "today" (follow-ups, applied dates).
APP_TIMEZONE=America/Los_Angeles

# Protects the nightly job-board check (Vercel sends it automatically once set). Any long random string.
CRON_SECRET=
