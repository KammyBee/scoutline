# Copy to .env.local for local work. On Vercel, add these in Project Settings → Environment Variables.

# Postgres connection string (Neon: use the "pooled" connection string). Leave unset locally to use a built-in PGlite database in .data/
DATABASE_URL=

# The password you type on the sign-in page. Optional once Google sign-in is set up (leave it set as a backup if you like).
APP_PASSWORD=

# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your time zone, used for "today" (follow-ups, applied dates).
APP_TIMEZONE=America/Los_Angeles

# Protects the nightly job-board check (Vercel sends it automatically once set). Any long random string.
CRON_SECRET=

# Claude features (optional). Without a key, everything else still works.
# Get a key at console.anthropic.com → API keys. Keep it secret: only here and in Vercel's settings.
ANTHROPIC_API_KEY=
# Most Claude calls allowed per day (safety cap). About 30 scores + a few letters is a normal day.
CLAUDE_DAILY_LIMIT=60
# Cover letters Claude drafts on its own after each check, for jobs it scored 4 or 5 (0 turns this off)
AUTO_LETTERS_PER_DAY=8
# Models. Haiku is cheap and fine for scoring; Sonnet writes better letters.
CLAUDE_SCORE_MODEL=claude-haiku-5-5
CLAUDE_WRITE_MODEL=claude-sonnet-5-5

# Google sign-in and Gmail tracking (phase 4). See "Gmail tracking" in the README for the setup steps.
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The one Google account allowed to sign in and connect Gmail.
GOOGLE_ALLOWED_EMAIL=
# Your site's address, e.g. https://scoutline.vercel.app. Leave unset locally (http://localhost:3000 is used).
APP_URL=
# Sender domains Scoutline never reads or saves, comma-separated. Put your current employer's domain here.
GMAIL_SKIP_DOMAINS=
# How far back the first Gmail sync reads, in days.
GMAIL_FIRST_SYNC_DAYS=45
# Follow-up rules: follow up this many days after applying; mark "No response" after this many quiet days (0 = never).
FOLLOW_UP_DAYS=7
NO_RESPONSE_DAYS=30
QUIET_INTERVIEW_DAYS=14
