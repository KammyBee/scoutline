{
  "name": "scoutline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "import": "tsx --env-file-if-exists=.env.local scripts/import-dashboard.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-jobs": "tsx --env-file-if-exists=.env.local scripts/fetch-jobs.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  },
  "description": "A personal job search pipeline: postings, applications, email history and cover letters in one place."
}
